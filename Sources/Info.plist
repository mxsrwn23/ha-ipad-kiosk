<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>de</string>
    <key>CFBundleDisplayName</key>
    <string>HA Kiosk</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- iPad only, no multitasking split view / slide over: keeps a single foreground app -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>

    <!-- Status bar hidden for full-screen dashboard -->
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Classic app-delegate lifecycle (no UIScene) so it keeps working on iOS 12 -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- Local Home Assistant servers are frequently plain HTTP / self-signed on the LAN -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>HA Kiosk verbindet sich mit deinem Home Assistant Server im lokalen Netzwerk.</string>
    <key>NSBonjourServices</key>
    <array/>

    <!-- Allow camera/media streams (HA cameras, media players) to autoplay inline -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Wird benötigt, falls dein Home Assistant Dashboard Mikrofon-Funktionen (z.B. Sprachassistent) einbindet.</string>
    <key>NSCameraUsageDescription</key>
    <string>Wird benötigt, falls dein Home Assistant Dashboard Kamera-Funktionen einbindet.</string>

    <!-- Best-effort background keep-alive (legacy Background Fetch, iOS12-compatible) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
</dict>
</plist>
